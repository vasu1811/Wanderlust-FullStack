<% layout("/layouts/boilerplate") %>

<title>404 - Page Not Found</title>

<style>
.page_404 {
    padding: 20px 0;
    background: #fff;
    font-family: 'Arvo', serif;
    text-align: center;
}

h1 {
    font-size: 80px;
    color: #333;
    margin-bottom: 10px;
}

.four_zero_four_bg {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
}

.four_zero_four_bg video {
    max-width: 100%;
    height: auto;
    display: block;
    position: relative;
    top: 0;
}

.contant_box_404 {
    margin-top: 20px;
}

.contant_box_404 h3 {
    font-size: 30px;
    color: #333;
}

.contant_box_404 p {
    font-size: 18px;
    color: #666;
}

.link_404 {
    color: #fff !important;
    padding: 10px 20px;
    background: #39ac31;
    margin: 20px 0;
    display: inline-block;
    text-decoration: none;
    font-size: 18px;
    border-radius: 5px;
}

.link_404:hover {
    background: #2e8c27;
}
</style>

<section class="page_404">
    <div class="container">
        <div class="row">
            <div class="col-sm-12 text-center">
                <div class="four_zero_four_bg">
                    <h1>Error:<%= error.statusCode %></h1>
                    <video src="/assets/404Error.mp4" autoplay muted loop></video>
                </div>
                <div class="contant_box_404">
                    <h3 class="h3">Looks like you're lost</h3>
                    <p><%= error.message %> </p>
                    <a href="/listings" class="link_404">Go to Home</a>
                </div>
            </div>
        </div>
    </div>
</section>
